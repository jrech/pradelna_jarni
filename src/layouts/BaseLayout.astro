---
import '@fontsource-variable/geist';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config/site';

interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
}

const {
  title,
  description,
  path = '/',
  image = siteConfig.image,
} = Astro.props;
const canonical = new URL(path, Astro.site ?? siteConfig.url);
const absoluteImage = new URL(image, Astro.site ?? siteConfig.url).href;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${siteConfig.url}/#business`,
  name: siteConfig.legalName,
  url: siteConfig.url,
  image: absoluteImage,
  logo: new URL(siteConfig.logo, Astro.site ?? siteConfig.url).href,
  description: siteConfig.description,
  telephone: siteConfig.contacts.sales.telephone,
  email: siteConfig.contacts.sales.email,
  address: {
    '@type': 'PostalAddress',
    ...siteConfig.address,
  },
  areaServed: siteConfig.areaServed,
};
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#19333d" />
    <meta name="author" content={siteConfig.name} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion-ready');
      }
    </script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#obsah">Přejít na obsah</a>
    <Header currentPath={path} />
    <main id="obsah">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
