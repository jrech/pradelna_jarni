---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<BaseLayout title={`${title} | Prádelna Jarní`} description={description} path={Astro.url.pathname}>
  <article class="legal-page">
    <header class="legal-header shell">
      <p class="eyebrow" data-reveal>Soukromí</p>
      <h1 class="display" data-reveal data-reveal-delay="0.08">{title}</h1>
    </header>
    <div class="shell legal-content">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .legal-page { color: var(--ink); background: var(--warm-white); }
  .legal-header { padding-block: var(--section-large) var(--space-12); }
  .legal-header h1 { max-width: 860px; margin: 0; font-size: clamp(var(--type-4xl), 5vw, var(--type-display-xl)); }
  .legal-content { max-width: 960px; padding-block: 0 var(--section-large); }
  .legal-content > section { max-width: 760px; padding-block: var(--section-standard); border-top: 1px solid var(--line); }
  .legal-content > section:first-child { padding-top: 0; border-top: 0; }
  .legal-content h2 { max-width: 640px; margin-bottom: var(--rel-heading-copy); font-size: var(--type-3xl); }
  .legal-content p { max-width: 700px; margin-bottom: var(--rel-content-group); font-size: var(--font-size-body); line-height: 1.55; }
  .legal-content p:last-child { margin-bottom: 0; }
  .legal-content a { text-decoration: underline; text-decoration-color: var(--orange); text-underline-offset: 4px; transition: color 250ms var(--ease-out); }
  .legal-content address { margin: 0 0 var(--rel-content-group); font-size: var(--type-lg); font-style: normal; line-height: 1.55; }
  .legal-content table { width: 100%; margin-top: var(--space-8); border-collapse: collapse; font-size: var(--font-size-body); text-align: left; }
  .legal-content th, .legal-content td { padding: 16px 12px 16px 0; border-top: 1px solid var(--line); vertical-align: top; line-height: 1.45; }
  .legal-content th { color: var(--orange); font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
  .legal-content td:first-child { font-weight: 500; }
  @media (hover: hover) and (pointer: fine) { .legal-content a:hover { color: var(--orange); } }
  @media (max-width: 640px) {
    .legal-header { padding-block: var(--section-standard) var(--space-8); }
    .legal-header h1 { font-size: var(--type-4xl); }
    .legal-content { padding-bottom: var(--section-standard); }
    .legal-content > section { padding-block: var(--section-standard); }
    .legal-content h2 { font-size: var(--type-3xl); }
    .legal-content table { display: block; overflow-x: auto; white-space: nowrap; }
  }
</style>
